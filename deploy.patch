diff --git a/migrations/005_sort_catalog_and_disable_demo_profiles.sql b/migrations/005_sort_catalog_and_disable_demo_profiles.sql
new file mode 100644
index 0000000..3b24c5a
--- /dev/null
+++ b/migrations/005_sort_catalog_and_disable_demo_profiles.sql
@@ -0,0 +1,53 @@
+-- Keep the requested city ordering and prevent sample accounts from appearing
+-- as paid, public listings. Rows are retained so an administrator can review
+-- or restore them without data loss.
+BEGIN;
+
+UPDATE public.cities AS c
+SET display_order = v.display_order
+FROM (VALUES
+  ('city-tbilisi', 1),
+  ('city-batumi', 2),
+  ('city-kutaisi', 3),
+  ('city-rustavi', 4),
+  ('city-akhaltsikhe', 5),
+  ('city-borjomi', 6),
+  ('city-gori', 7),
+  ('city-zestafoni', 8),
+  ('city-zugdidi', 9),
+  ('city-telavi', 10),
+  ('city-kobuleti', 11),
+  ('city-martvili', 12),
+  ('city-samtredia', 13),
+  ('city-svaneti', 14),
+  ('city-tskaltubo', 15),
+  ('city-poti', 16),
+  ('city-khashuri', 17)
+) AS v(id, display_order)
+WHERE c.id = v.id;
+
+UPDATE public.users
+SET status = 'BLOCKED', updated_at = NOW()
+WHERE id IN ('usr-cm-1','usr-cm-2','usr-cm-3','usr-cm-4','usr-cm-5')
+  AND 'CRAFTSMAN' = ANY(roles)
+  AND status = 'ACTIVE';
+
+UPDATE public.craftsmen
+SET status = 'BLOCKED', updated_at = NOW()
+WHERE id IN ('cm-1','cm-2','cm-3','cm-4','cm-5')
+  AND status = 'ACTIVE';
+
+UPDATE public.craftsman_listings
+SET status = 'EXPIRED', updated_at = NOW()
+WHERE craftsman_id IN ('cm-1','cm-2','cm-3','cm-4','cm-5')
+  AND status = 'ACTIVE';
+
+UPDATE public.top15_memberships
+SET status = 'REVOKED'
+WHERE craftsman_id IN ('cm-1','cm-2','cm-3','cm-4','cm-5')
+  AND status = 'ACTIVE';
+
+DELETE FROM public.user_sessions
+WHERE user_id IN ('usr-cm-1','usr-cm-2','usr-cm-3','usr-cm-4','usr-cm-5');
+
+COMMIT;
